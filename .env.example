# TaskSync configuration. Copy to .env and fill in. Never commit .env.

# Notion internal integration token, from https://www.notion.so/my-integrations
NOTION_TOKEN=your-notion-integration-token

# Database ID of the shared team board (the 32-character ID in the database URL)
NOTION_TEAM_DB_ID=00000000000000000000000000000000

# Database ID of your private sync database
NOTION_SYNC_DB_ID=00000000000000000000000000000000

# Your name exactly as it appears in the "Assigned To" people property
NOTION_USER_NAME=Your Name

# TickTick OAuth app, registered at https://developer.ticktick.com
TICKTICK_CLIENT_ID=your-ticktick-client-id
TICKTICK_CLIENT_SECRET=your-ticktick-client-secret

# Printed by: python -m tasksync.auth_ticktick
TICKTICK_ACCESS_TOKEN=your-ticktick-access-token
TICKTICK_REFRESH_TOKEN=your-ticktick-refresh-token

# ID of the TickTick project (list) to sync with. The OAuth helper prints your project IDs.
TICKTICK_PROJECT_ID=your-ticktick-project-id

# last_write | notion_priority | ticktick_priority
CONFLICT_STRATEGY=last_write

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Directory created at startup. Holds ticktick_tokens.json, the refreshed TickTick
# tokens, which override the two token values above. Keep it out of git.
DATA_DIR=./data
